# Node Environment
NODE_ENV=development
PORT=5000

# Client Configuration
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusprint?schema=public

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_environment_12345
JWT_EXPIRES_IN=1d

# Uploads Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=25

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
