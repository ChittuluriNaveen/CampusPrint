# CampusPrint Master Environment Variables Template

# Node Environment (development | staging | production | test)
NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres_secure_password@postgres:5432/campusprint?schema=public"

# Database Credentials (for Docker container initialization)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=campusprint

# JSON Web Token Secret & Duration
JWT_SECRET="campusprint_production_jwt_signing_secret_key_change_me_2026"
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway API Keys
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Storage Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# CORS & Client Application URL
CORS_ORIGIN="http://localhost,https://campusprint.edu"
VITE_API_BASE_URL="http://localhost:5000/api/v1"
